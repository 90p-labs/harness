{{define "region"}}<div class="app" id="board" hx-get="/regions/board" hx-trigger="every 5s" hx-swap="morph:outerHTML" data-v="{{.Board.Version}}">
<aside class="side" aria-label="Board">
<div class="ws"><span class="ws-logo" aria-hidden="true"></span>harness</div>
<nav class="nav" aria-label="Columns"><ol>
{{range .Board.Columns}}<li><a href="#col-{{.Key}}">{{.Name}}<span class="n{{if .NeedsYou}} bad{{end}}">{{len .Cards}}</span></a></li>
{{end}}</ol></nav>
<div class="side-foot">
<button class="theme" type="button" data-theme-toggle data-morph-keep aria-label="Switch the color theme">Theme: <span>auto</span></button>
</div>
</aside>
<div>
<header class="top">
<div class="crumbs"><span>Runs</span><span class="sep">/</span><b>Board</b></div>
</header>
<main>
<div class="strip">
{{range .Board.Columns}}<div class="col" id="col-{{.Key}}">
<div class="col-h">{{.Name}}<span class="n">{{len .Cards}}</span></div>
{{range .Cards}}<article class="task">
<div class="tid"><span class="rid" title="{{.ID}}">{{.ID}}</span><span class="spacer"></span>{{if .Blocked}}<span class="st st-fail">blocked</span>{{else}}<span class="st">{{.Phase}}</span>{{end}}</div>
<h3><a href="/runs/{{.ID}}" title="{{.Title}}">{{.Title}}</a></h3>
{{if or .Branch .PRURL}}<div class="chips">{{with .Branch}}<span class="chip" title="{{.}}"><span class="chip-t">{{.}}</span></span>{{end}}{{with .PRURL}}<a class="chip" href="{{.}}" title="{{.}}" rel="noopener noreferrer"><span class="chip-t">PR</span></a>{{end}}</div>{{end}}
</article>
{{end}}</div>
{{end}}</div>
</main>
</div>
</div>{{end}}
{{define "page"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>harness panel</title>
<style>{{.Links.Fonts}}</style>
<style>{{.Links.Tokens}}</style>
<style>{{.Kit}}</style>
<style>{{.CSS}}</style>
</head>
<body hx-ext="morph">
{{template "region" .}}
<script src="{{.Links.Htmx}}"></script>
<script src="{{.Links.Morph}}"></script>
<script src="{{.Links.Panel}}"></script>
<script>{{.JS}}</script>
</body>
</html>{{end}}
