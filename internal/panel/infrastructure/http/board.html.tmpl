{{define "region"}}<main id="board" hx-get="/regions/board" hx-trigger="every 5s" hx-swap="morph:outerHTML" data-v="{{.Board.Version}}">
{{range .Board.Columns}}<section class="col{{if eq .Name "Approval"}} needs-you{{end}}">
<h2>{{.Name}}{{if eq .Name "Approval"}} <small>(needs you)</small>{{end}} <span class="n">{{len .Cards}}</span></h2>
{{range .Cards}}<a class="card{{if eq .Phase "blocked"}} blocked{{end}}" href="/runs/{{.ID}}">
<strong>{{.Title}}</strong>
{{if eq .Phase "blocked"}}<span class="tag">blocked</span>{{end}}
<span class="meta">{{.Phase}}</span>
{{if .Branch}}<span class="meta">{{.Branch}}</span>{{end}}
{{if .PRURL}}<span class="meta">{{.PRURL}}</span>{{end}}
</a>
{{end}}</section>
{{end}}</main>{{end}}
{{define "page"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>harness panel</title>
<style>
{{.Links.Fonts}}
{{.Links.Tokens}}
:root{--ink:#1e1e1e;--paper:#faf8f4;--line:#d9d4c8;--amber:#e0a84a}
*{box-sizing:border-box}
body{margin:0;padding:20px;background:var(--paper);color:var(--ink);font-family:'Source Sans 3',sans-serif}
header h1{margin:0;font-family:'Instrument Serif',serif;font-weight:400;font-size:28px}
header p{margin:4px 0 16px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#666}
#board{display:grid;grid-template-columns:repeat(6,minmax(160px,1fr));gap:10px;align-items:start}
.col{border:1px solid var(--line);border-radius:6px;padding:10px;min-height:360px}
.col h2{margin:0 0 10px;font-family:'Instrument Serif',serif;font-weight:400;font-size:18px}
.col h2 small{font-family:'Source Sans 3',sans-serif;font-size:12px;color:#8a6516}
.col h2 .n{float:right;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#666}
.card{display:block;margin-bottom:8px;padding:8px;border:1px solid var(--ink);border-radius:4px;background:#fff;color:inherit;text-decoration:none}
.needs-you .card{background:var(--amber)}
.card:hover{box-shadow:2px 2px 0 var(--ink)}
.card .meta{display:block;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#555;overflow-wrap:anywhere}
.card .tag{font-size:11px;color:var(--amber)}
.needs-you .card .tag{color:var(--ink)}
</style>
</head>
<body hx-ext="morph">
<header><h1>harness panel</h1><p>runs of this repo</p></header>
{{template "region" .}}
<script src="{{.Links.Htmx}}"></script>
<script src="{{.Links.Morph}}"></script>
<script src="{{.Links.Panel}}"></script>
</body>
</html>{{end}}
