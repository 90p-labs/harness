<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}: program</title>
<style>{{.Fonts}}</style>
<style>{{.Tokens}}</style>
<style>{{.CSS}}</style>
</head>
<body>
<div class="app">
<aside class="side" aria-label="Sections">
<div class="ws"><span class="ws-logo" aria-hidden="true"></span>harness</div>
<nav id="nav" class="nav" aria-label="Sections">
{{range $g := .Nav}}<div data-nav-group="{{$g.Name}}"><div class="nav-h">{{$g.Name}}</div><ol>
{{range $g.Items}}<li><a href="#{{.Anchor}}">{{.Label}}{{if .Count}}<span class="n{{if .Bad}} bad{{end}}">{{.Count}}</span>{{end}}</a></li>
{{end}}</ol></div>
{{end}}</nav>
<div class="side-foot">
<button class="theme" type="button" data-theme-toggle aria-label="Switch the color theme">Theme: <span>auto</span></button>
</div>
</aside>
<div>
<header class="top">
<div class="crumbs"><span>Runs</span><span class="sep">/</span><b>{{.Title}}</b></div>
<span class="spacer"></span>
</header>
<div class="page">
<main>
<section id="summary" class="masthead" data-group="{{.GroupName}}">
<p class="eyebrow"><span>program</span></p>
<h1 class="title">{{.Title}}</h1>
{{range .Goal}}<p class="goal">{{.}}</p>
{{end}}</section>
<section id="waves" data-group="{{.GroupName}}" aria-labelledby="waves-h"><h2 id="waves-h">Runs by wave <span class="n">{{.Counts.Runs}}</span></h2>
<p class="lede">Runs in one wave share no dependency, so they can run in parallel.</p><div class="waves">
{{range .Waves}}<div class="wave"><p class="wave-n">Wave {{.Number}}</p><div class="board">
{{range .Runs}}<article id="{{.Key}}" class="task run"><header class="tid"><span class="tn">{{.ID}}</span></header><h3>{{.Slug}}</h3>
<p class="branch"><em>Branch</em><code>{{.Branch}}</code></p>
<ul class="owned">{{range .Owned}}<li><code>{{.}}</code></li>{{end}}</ul>
<ol class="scope">{{range .Scope}}<li>{{.}}</li>{{end}}</ol>
<p class="done-when"><em>Done when</em>{{.DoneWhen}}</p>
{{if .After}}<div class="links"><span class="lk"><em>After</em>{{range .After}}{{if .Href}}<a class="chip" href="#{{.Href}}">{{.Label}}</a>{{else}}<span class="chip broken" title="No such run">{{.Label}}</span>{{end}}{{end}}</span></div>
{{end}}</article>
{{end}}</div></div>
{{end}}</div></section>
<section id="dependencies" data-group="{{.GroupName}}" aria-labelledby="dependencies-h"><h2 id="dependencies-h">Dependencies</h2>
<p class="lede">An arrow points from a run to the run that waits for it.</p>
{{range $i, $d := .Data.Diagrams}}<figure class="diagram"><div class="mm" data-diagram="{{$i}}" role="img" aria-label="Run dependency diagram"></div>
<figcaption><span>flowchart</span><details><summary>Diagram source</summary><pre class="src">{{$d}}</pre></details></figcaption></figure>
{{end}}</section>
{{if .Rows}}<section id="measurement" data-group="{{.GroupName}}" aria-labelledby="measurement-h"><h2 id="measurement-h">Measurement</h2>
<div class="table-wrap"><table class="measure"><thead><tr>{{range .Header}}<th scope="col">{{.}}</th>{{end}}</tr></thead><tbody>
{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>
{{end}}</tbody></table></div></section>{{end}}
{{if .Decisions}}<section id="decisions" data-group="{{.GroupName}}" aria-labelledby="decisions-h"><h2 id="decisions-h">Decisions</h2><div class="notes"><div><ul>{{range .Decisions}}<li>{{.}}</li>{{end}}</ul></div></div></section>{{end}}

<section id="problems" class="problems" data-group="{{.GroupQA}}" aria-labelledby="problems-h"><h2 id="problems-h">Problems <span class="n">{{.Counts.Problems}}</span></h2>
{{if .Problems}}<ul>
{{range .Problems}}<li class="problem">{{if .Anchor}}<a class="loc" href="#{{.Anchor}}">plan.md:{{.Line}}</a>{{else}}<span class="loc">plan.md{{with .Line}}:{{.}}{{end}}</span>{{end}}<span class="rule">{{.Rule}}</span><span class="ptext">{{.Message}}</span></li>
{{end}}</ul>{{else}}<p class="clean">The plan passes every check.</p>{{end}}
</section>
<section id="source" data-group="{{.GroupQA}}" aria-labelledby="source-h"><h2 id="source-h">Source</h2>
<details class="source" id="source-details"><summary><code>plan.md</code>, {{len .Source}} lines</summary><pre class="lines">{{range .Source}}<span id="L{{.N}}" class="ln{{if .Bad}} bad{{end}}"><a href="#L{{.N}}">{{.N}}</a>{{.Text}}</span>
{{end}}</pre></details></section>
<footer class="foot">Rendered by <code>harness plan view</code> from <code>plan.md</code>. This page loads nothing from the network.</footer>
</main>
<aside class="props" id="props" aria-label="Properties">
<div>
<h4>Properties</h4>
<div class="prop"><span>Runs</span><span class="v">{{.Counts.Runs}}</span></div>
<div class="prop"><span>Waves</span><span class="v">{{.Counts.Waves}}</span></div>
<div class="prop"><span>Problems</span><span class="v">{{.Counts.Problems}}</span></div>
</div>
</aside>
</div>
</div>
</div>
<script type="application/json" id="plan-data">{{.Data}}</script>
<script>{{.Mermaid}}</script>
<script>{{.JS}}</script>
</body>
</html>
