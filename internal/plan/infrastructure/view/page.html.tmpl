<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}: plan</title>
<style>{{.Fonts}}</style>
<style>{{.Tokens}}</style>
<style>{{.CSS}}</style>
</head>
<body>
<div class="shell">
<nav class="rail" aria-label="Sections">
<div class="brand"><span class="brand-mark" aria-hidden="true"></span>harness<span class="brand-sub">plan view</span></div>
<div class="navgroups">
{{range $i, $g := .Nav}}<div class="navgrp" data-nav-group="{{$g.Name}}"><p class="navgrp-h"><span>{{$g.Number}}</span>{{$g.Name}}</p><ol>
{{range $g.Items}}<li><a href="#{{.Anchor}}">{{.Label}}{{if .Count}}<span class="count{{if .Bad}} bad{{end}}">{{.Count}}</span>{{end}}</a></li>
{{end}}</ol></div>
{{end}}</div>
<div class="legend" aria-label="Change colors"><p>Changes</p>
<span class="lg lg-added"><i></i>new</span>
<span class="lg lg-modified"><i></i>changed</span>
<span class="lg lg-deleted"><i></i>deleted</span>
</div>
<button class="theme" type="button" data-theme-toggle aria-label="Switch the color theme">Theme: <span>auto</span></button>
</nav>
<main>
<div class="group" id="grp-product">
<p class="group-h"><span>01</span>{{.G.Product}}</p>
<section id="summary" class="masthead" data-group="{{.G.Product}}">
<p class="eyebrow">{{with .Run.Phase}}<span class="phase">{{.}}</span>{{end}}{{with .Run.ID}}<span>run {{.}}</span>{{end}}</p>
<h1>{{.Title}}</h1>
{{range .Goal}}<p class="goal">{{.}}</p>
{{end}}<dl class="facts">
{{with .Track}}<div><dt>Track</dt><dd>{{.}}</dd></div>{{end}}
{{with .Run.Branch}}<div><dt>Branch</dt><dd><code>{{.}}</code></dd></div>{{end}}
<div><dt>Criteria</dt><dd>{{.Counts.Criteria}}</dd></div>
<div><dt>Tasks</dt><dd>{{.Counts.Tasks}}</dd></div>
<div><dt>Files</dt><dd>{{.Counts.Files}}</dd></div>
<div><dt>Problems</dt><dd>{{.Counts.Problems}}</dd></div>
</dl>
</section>
<section id="criteria" data-group="{{.G.Product}}" aria-labelledby="criteria-h"><h2 id="criteria-h">Acceptance criteria</h2>
<ol class="criteria">
{{range .Criteria}}<li id="{{.Key}}" data-state="{{.State}}" data-key="{{.Key}}" class="criterion"><span class="cn">{{.Number}}</span><div class="cbody"><p>{{.Text}}</p>
<p class="verdict"><span class="st st-{{cls .State}}">{{.State}}</span></p>
<div class="links">
{{template "chips" dict "Name" "Tasks" "Chips" .Tasks}}{{template "chips" dict "Name" "Specs" "Chips" .Specs}}{{template "chips" dict "Name" "Commits" "Chips" .Commits}}{{template "chips" dict "Name" "Signal" "Chips" .Signal}}</div></div></li>
{{end}}</ol></section>
{{if .Notes}}<section id="notes" data-group="{{.G.Product}}" aria-labelledby="notes-h"><h2 id="notes-h">Decisions and risks</h2><div class="notes">
{{range .Notes}}<div><h3>{{.Title}}</h3><ul>{{range .Items}}<li>{{.}}</li>{{end}}</ul></div>
{{end}}</div></section>{{end}}
</div>

<div class="group" id="grp-specs">
<p class="group-h"><span>02</span>{{.G.Specs}}</p>
<section id="specs" data-group="{{.G.Specs}}" aria-labelledby="specs-h"><h2 id="specs-h">Tech specs</h2>
<p class="lede">Colors mark the change: <span class="mark mark-new">new</span> <span class="mark mark-changed">changed</span> <span class="mark mark-deleted">deleted</span></p>
{{range .Specs}}<article id="{{.Key}}" class="spec" data-key="{{.Key}}"><header><h3>{{.Title}}</h3><p class="spec-meta">{{template "chips" dict "Name" "Criteria" "Chips" .Criteria}}</p></header>
{{range .Prose}}<p>{{.}}</p>
{{end}}{{range .Diagrams}}<figure class="diagram"><div class="mm" data-diagram="{{.Index}}" role="img" aria-label="{{.Kind}} diagram"></div>
<figcaption><span>{{.Kind}}</span><details><summary>Plan source</summary><pre class="src">{{.Source}}</pre></details></figcaption></figure>
{{end}}{{range .Sketches}}<figure class="diagram sketch-fig"><div class="sketch-wrap" role="img" aria-label="{{.Title}}">{{if .SVG}}{{.SVG}}{{else if .Error}}<p class="sketch-error">{{.Error}}</p>{{else}}<p class="sketch-error">No sketch for this link.</p>{{end}}</div>
<figcaption><span>excalidraw, <code>{{.Path}}</code></span><span class="cap">{{.Title}}</span></figcaption></figure>
{{end}}</article>
{{end}}</section>
<section id="trees" data-group="{{.G.Specs}}" aria-labelledby="trees-h"><h2 id="trees-h">Files</h2><div class="trees">
{{range .Trees}}<div class="tree"><p class="tree-h">{{.Title}}</p><pre>{{range .Rows}}<span class="tr{{if not .Dir}} file ch-{{.Mark}}{{end}}"{{if .ID}} id="{{.ID}}" data-key="{{.ID}}"{{end}}{{if .State}} data-state="{{.State}}"{{end}} style="--depth: {{.Depth}}">{{if .Dir}}<span class="dir">{{.Name}}</span>{{else}}<span class="fname">{{.Name}}</span><span class="mark mark-{{.Mark}}">{{.Mark}}</span><span class="st st-{{cls .State}}">{{.State}}</span>{{template "chips" dict "Name" "" "Chips" .Owners}}{{end}}</span>
{{end}}</pre></div>
{{end}}</div></section>
</div>

<div class="group" id="grp-tasks">
<p class="group-h"><span>03</span>{{.G.Tasks}}</p>
<section id="tasks" data-group="{{.G.Tasks}}" aria-labelledby="tasks-h"><h2 id="tasks-h">Tasks</h2>
<p class="lede">Tasks in one wave share no dependency, so they can run in parallel.</p><div class="waves">
{{range .Waves}}<div class="wave"><p class="wave-n">Wave {{.Number}}</p>
{{range .Tasks}}<article id="{{.Key}}" class="task" data-key="{{.Key}}"><header><span class="tn">{{.Number}}</span><h3>{{.Name}}</h3><span class="side">{{.Side}}</span>{{if .Model}}<span class="side">{{.Model}}</span>{{end}}</header>
<p class="tf"><em>Test first</em>{{.TestFirst}}</p>
<ul class="owned">{{range .Owned}}<li><code>{{.}}</code></li>{{end}}</ul>
<div class="links">{{template "chips" dict "Name" "DoD" "Chips" .DoD}}{{template "chips" dict "Name" "After" "Chips" .After}}{{template "chips" dict "Name" "Commit" "Chips" .Commits}}</div></article>
{{end}}</div>
{{end}}</div></section>
<section id="delivery" data-group="{{.G.Tasks}}" aria-labelledby="delivery-h"><h2 id="delivery-h">Commits and PR</h2>
<ol class="commits">
{{range .Commits}}<li id="{{.Key}}" data-state="{{.State}}" data-key="{{.Key}}"><span class="kn">{{.Number}}</span><code>{{.Subject}}</code><span class="links"><span class="st st-{{cls .State}}">{{.State}}</span>{{template "chips" dict "Name" "" "Chips" .Tasks}}</span></li>
{{end}}</ol>
{{range .PRs}}<div id="{{.Key}}" class="pr" data-key="{{.Key}}">{{if .ThisRun}}<span class="pr-tag">this run</span>{{end}}<code>{{.Branch}}</code>{{with .Base}} into <code>{{.}}</code>{{end}}</div>
{{end}}</section>
</div>

<div class="group" id="grp-qa">
<p class="group-h"><span>04</span>{{.G.QA}}</p>
<section id="problems" class="problems" data-group="{{.G.QA}}" aria-labelledby="problems-h"><h2 id="problems-h">Problems <span class="n">{{.Counts.Problems}}</span></h2>
{{if .Problems}}<ul>
{{range .Problems}}<li class="problem">{{if .Anchor}}<a class="loc" href="#{{.Anchor}}">plan.md:{{.Line}}</a>{{else}}<span class="loc">plan.md{{with .Line}}:{{.}}{{end}}</span>{{end}}<span class="rule">{{.Rule}}</span><span class="ptext">{{.Message}}</span></li>
{{end}}</ul>{{else}}<p class="clean">The plan passes every check.</p>{{end}}
</section>
<section id="trace-matrix" data-group="{{.G.QA}}" aria-labelledby="matrix-h"><h2 id="matrix-h">Traceability</h2>
<p class="lede">Each row is a criterion. A dot marks the task that owns it. Point at any item to see its links and their state.</p>
<div class="matrix-wrap"><table class="matrix"><thead><tr><th scope="col">Criterion</th>{{range .Matrix.Tasks}}<th scope="col"><a href="#{{.Href}}" data-key="{{.Href}}" title="{{.Title}}">{{.Label}}</a></th>{{end}}<th scope="col">Specs</th><th scope="col">Files</th><th scope="col">Signal</th><th scope="col">Proof</th></tr></thead><tbody>
{{range .Matrix.Rows}}<tr data-key="{{.Key}}" data-state="{{.State}}"><th scope="row"><a href="#{{.Key}}" data-key="{{.Key}}"><b>{{.Number}}</b> {{.Text}}</a></th>{{range .Dots}}<td>{{if .}}<span class="dot" aria-label="owns"></span>{{end}}</td>{{end}}<td class="num">{{.Specs}}</td><td class="num">{{.Files}}</td><td class="num">{{.Signals}}</td><td><span class="st st-{{cls .State}}">{{.State}}</span></td></tr>
{{end}}</tbody></table></div></section>
<section id="proofs" data-group="{{.G.QA}}" aria-labelledby="proofs-h"><h2 id="proofs-h">Proof commands</h2>
<ul class="proofs">
{{range .Criteria}}<li><span class="cn-mini">{{.Number}}</span><div class="proof"><code>{{.Proof}}</code><span class="st st-{{cls .State}}">{{.State}}</span><button type="button" class="copy" data-copy="{{.Proof}}">Copy</button></div></li>
{{end}}</ul></section>
<section id="source" data-group="{{.G.QA}}" aria-labelledby="source-h"><h2 id="source-h">Source</h2>
<details class="source" id="source-details"><summary><code>plan.md</code>, {{len .Source}} lines</summary><pre class="lines">{{range .Source}}<span id="L{{.N}}" class="ln{{if .Bad}} bad{{end}}"><a href="#L{{.N}}">{{.N}}</a>{{.Text}}</span>
{{end}}</pre></details></section>
</div>

<div class="group" id="grp-signals">
<p class="group-h"><span>05</span>{{.G.Signals}}</p>
<section id="signals" data-group="{{.G.Signals}}" aria-labelledby="signals-h"><h2 id="signals-h">Signals</h2>
<p class="lede">After the deploy, the live loop checks each signal over its window. A breach sends the run back to planning.</p>
<div class="table-wrap"><table class="signals"><thead><tr><th>Criterion</th><th>Signal</th><th>Source</th><th>Query</th><th>Breach</th><th>Window</th><th>Panel</th></tr></thead><tbody>
{{range .Signals}}<tr id="{{.Key}}" data-key="{{.Key}}"><td>{{template "chips" dict "Name" "" "Chips" .Criterion}}</td><td>{{.Signal}}</td><td>{{.Source}}</td><td><code>{{.Query}}</code></td><td><code>{{.Breach}}</code></td><td><code>{{.Window}}</code></td><td>{{.Panel}}</td></tr>
{{end}}</tbody></table></div>
{{with .Regression}}<h3>Regression impact</h3>{{range .}}<p>{{.}}</p>{{end}}{{end}}
</section>
</div>
<footer class="foot">Rendered by <code>harness plan view</code> from <code>plan.md</code>. This page loads nothing from the network.</footer>
</main>
<aside class="tracer" id="tracer" aria-live="polite" hidden><header><p class="tr-k">Trace</p><p class="tr-t" id="tracer-title"></p><button type="button" id="tracer-close" aria-label="Close the trace">Close</button></header><div id="tracer-body"></div><p class="tr-hint">Click an item to pin its trace.</p></aside>
</div>
<script type="application/json" id="plan-data">{{.Data}}</script>
<script>{{.Mermaid}}</script>
<script>{{.JS}}</script>
</body>
</html>
{{define "chips"}}{{if .Chips}}<span class="lk">{{if .Name}}<em>{{.Name}}</em>{{end}}{{range .Chips}}{{if .Href}}<a class="chip" href="#{{.Href}}" data-key="{{.Href}}"{{with .Title}} title="{{.}}"{{end}}>{{.Label}}</a>{{else}}<span class="chip broken" title="No such item">{{.Label}}</span>{{end}}{{end}}</span>{{end}}{{end}}
