-- src/components/greeting.tsx --
'use client'

import { useState } from 'react'

export function Greeting({ name }: { name: string }) {
  const [loud, setLoud] = useState(false)
  return <button onClick={() => setLoud(!loud)}>{loud ? name.toUpperCase() : name}</button>
}
