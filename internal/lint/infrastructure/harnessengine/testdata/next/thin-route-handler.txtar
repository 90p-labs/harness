-- src/app/layout.tsx --
import './globals.css'

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <body>{children}</body>
    </html>
  )
}
-- src/app/page.tsx --
import { Greeting } from '@/components/greeting'

export default function Page() {
  return <Greeting name="world" />
}
