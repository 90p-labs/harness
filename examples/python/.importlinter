[importlinter]
root_package = shop
include_external_packages = True
contract_types =
    domain_purity: domain_purity.DomainPurityContract

[importlinter:contract:src-roots]
name = ddd/src-roots
type = layers
containers =
    shop
layers =
    (order) : (billing) : (shared)
exhaustive = true

[importlinter:contract:context-layers]
name = ddd/src-roots
type = layers
containers =
    shop.*
layers =
    (infrastructure) : (application) : (domain)
exhaustive = true

[importlinter:contract:domain-purity]
name = ddd/domain-purity
type = domain_purity
source_modules =
    shop.*.domain
allowed_modules =
    shop.shared.domain

[importlinter:contract:layer-direction]
name = ddd/layer-direction
type = layers
containers =
    shop.*
layers =
    (infrastructure)
    (application)

[importlinter:contract:cross-context]
name = ddd/cross-context
type = independence
modules =
    shop.*
unmatched_ignore_imports_alerting = none
ignore_imports =
    shop.** -> shop.*
    shop.** -> shop.shared.**

[importlinter:contract:shared-kernel]
name = ddd/cross-context
type = layers
containers =
    shop
layers =
    (order) : (billing)
    (shared)
